+<script setup lang="ts">
+import {computed, nextTick, onBeforeUnmount, onMounted, ref, watch} from 'vue'
+import {useI18n} from 'vue-i18n'
+
+import BaseButton from '@/components/base/BaseButton.vue'
+import Icon from '@/components/misc/Icon'
+import {
+	deleteTaskLocation,
+	getMapsConfig,
+	getTaskLocation,
+	saveTaskLocation,
+	searchLocations,
+	type GeocodeResult,
+	type MapsConfig,
+	type TaskLocation,
+} from '@/client/queries/maps'
+import {error, success} from '@/message'
+
+const props = withDefaults(defineProps<{
+	taskId: number
+	disabled?: boolean
+}>(), {
+	disabled: false,
+})
+
+const emit = defineEmits<{
+	'updated': [location: TaskLocation | null]
+	'cleared': []
+}>()
+
+const {t} = useI18n()
+
+const savedLocation = ref<TaskLocation | null>(null)
+const searchQuery = ref('')
+const suggestions = ref<GeocodeResult[]>([])
+const isSearching = ref(false)
+const showDropdown = ref(false)
+const isEditing = ref(false)
+const inputRef = ref<HTMLInputElement | null>(null)
+const mapsConfig = ref<MapsConfig>({provider: 'photon', supports_autocomplete: false})
+
+const supportsAutocomplete = computed(() => mapsConfig.value.supports_autocomplete)
+
+let debounceTimer: ReturnType<typeof setTimeout> | null = null
+let abortController: AbortController | null = null
+
+const mapUrl = computed(() => {
+	if (!savedLocation.value) return ''
+	const {latitude, longitude} = savedLocation.value
+	return `https://www.openstreetmap.org/?mlat=${latitude}&mlon=${longitude}#map=16/${latitude}/${longitude}`
+})
+
+async function loadLocation() {
+	if (!props.taskId) return
+	try {
+		savedLocation.value = await getTaskLocation(props.taskId)
+	} catch {
+		savedLocation.value = null
+		error(t('task.location.loadError'))
+	}
+	emit('updated', savedLocation.value)
+}
+
+async function executeSearch() {
+	if (debounceTimer) clearTimeout(debounceTimer)
+	const q = searchQuery.value.trim()
+	if (q.length < 2) {
+		suggestions.value = []
+		showDropdown.value = false
+		return
+	}
+
+	if (abortController) {
+		abortController.abort()
+	}
+	const currentAbort = new AbortController()
+	abortController = currentAbort
+
+	isSearching.value = true
+	showDropdown.value = true
+	try {
+		const results = await searchLocations(q, currentAbort.signal)
+		if (abortController === currentAbort) {
+			suggestions.value = results
+		}
+	} catch (e: unknown) {
+		if ((e instanceof DOMException && e.name === 'AbortError') || (e as Error)?.name === 'AbortError' || currentAbort.signal.aborted) {
+			return
+		}
+		if (abortController === currentAbort) {
+			suggestions.value = []
+			error(t('task.location.searchError'))
+		}
+	} finally {
+		if (abortController === currentAbort) {
+			isSearching.value = false
+		}
+	}
+}
+
+function onSearchInput() {
+	if (!supportsAutocomplete.value) {
+		// Public Nominatim compliance: autocomplete-as-you-type strictly prohibited.
+		return
+	}
+	if (debounceTimer) clearTimeout(debounceTimer)
+	const q = searchQuery.value.trim()
+	if (q.length < 3) {
+		suggestions.value = []
+		showDropdown.value = false
+		return
+	}
+	isSearching.value = true
+	showDropdown.value = true
+	debounceTimer = setTimeout(() => {
+		executeSearch()
+	}, 400)
+}
+
+function onFocus() {
+	if (supportsAutocomplete.value && searchQuery.value.trim().length >= 3 && suggestions.value.length > 0) {
+		showDropdown.value = true
+	}
+}
+
+async function selectSuggestion(item: GeocodeResult) {
+	try {
+		const lat = typeof item.lat === 'number' ? item.lat : (item.latitude ?? 0)
+		const lon = typeof item.lon === 'number' ? item.lon : (item.longitude ?? 0)
+		const address = item.address || item.display_name
+		const displayName = item.display_name || address
+		const title = item.display_name && item.display_name !== address ? item.display_name : displayName
+		const saved = await saveTaskLocation(props.taskId, {
+			display_name: displayName,
+			title,
+			address,
+			latitude: lat,
+			longitude: lon,
+		})
+		savedLocation.value = saved
+		suggestions.value = []
+		searchQuery.value = ''
+		showDropdown.value = false
+		isEditing.value = false
+		emit('updated', saved)
+		success(t('task.location.saved'))
+	} catch {
+		error(t('task.location.saveError'))
+	}
+}
+
+async function clearLocation() {
+	try {
+		await deleteTaskLocation(props.taskId)
+		savedLocation.value = null
+		isEditing.value = false
+		emit('updated', null)
+		emit('cleared')
+		success(t('task.location.removed'))
+	} catch {
+		error(t('task.location.deleteError'))
+	}
+}
+
+function startEditing() {
+	if (props.disabled) return
+	searchQuery.value = savedLocation.value?.address ?? ''
+	isEditing.value = true
+	nextTick(() => {
+		inputRef.value?.focus()
+	})
+}
+
+function cancelEditing() {
+	if (abortController) {
+		abortController.abort()
+		abortController = null
+	}
+	if (debounceTimer) {
+		clearTimeout(debounceTimer)
+		debounceTimer = null
+	}
+	isEditing.value = false
+	showDropdown.value = false
+	suggestions.value = []
+}
+
+function onBlur() {
+	setTimeout(() => {
+		showDropdown.value = false
+		if (savedLocation.value) {
+			isEditing.value = false
+		}
+	}, 200)
+}
+
+function focus() {
+	isEditing.value = true
+	nextTick(() => {
+		inputRef.value?.focus()
+	})
+}
+
+defineExpose({
+	focus,
+})
+
+watch(() => props.taskId, () => {
+	loadLocation()
+})
+
+onMounted(async () => {
+	try {
+		mapsConfig.value = await getMapsConfig()
+	} catch {
+		mapsConfig.value = {provider: 'photon', supports_autocomplete: false}
+	}
+	loadLocation()
+})
+
+onBeforeUnmount(() => {
+	if (debounceTimer) {
+		clearTimeout(debounceTimer)
+		debounceTimer = null
+	}
+	if (abortController) {
+		abortController.abort()
+		abortController = null
+	}
+})
+</script>
